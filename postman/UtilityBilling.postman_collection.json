{
  "info": {
    "name": "Utility Billing System",
    "_postman_id": "ub-collection-0001",
    "description": "End-to-end + negative tests for the Utility Billing System. Login is two-step with an email OTP: run 'Login (step 1)', read the OTP from the app console, paste it into the collection variable 'otp', then run 'Verify OTP (step 2)' which auto-saves the JWT into 'token'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "otp", "value": "000000" },
    { "key": "adminEmail", "value": "admin@utility.rw" },
    { "key": "adminPass", "value": "Admin123!" },
    { "key": "billRef", "value": "BILL-2026-05-000001" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Signup (new account, INACTIVE + OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signup", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","signup"] },
            "body": { "mode": "raw", "raw": "{\n  \"fullNames\": \"Alice Customer\",\n  \"email\": \"alice@example.rw\",\n  \"phoneNumber\": \"+250788999000\",\n  \"password\": \"Secret123!\",\n  \"role\": \"ROLE_CUSTOMER\"\n}" }
          }
        },
        {
          "name": "Verify Account (signup OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/verify-account", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","verify-account"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.rw\",\n  \"otp\": \"{{otp}}\"\n}" }
          }
        },
        {
          "name": "Login (step 1) - admin",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('step 1 returns OTP challenge', () => pm.response.code === 200);",
              "console.log('Now read the OTP from the app console and set the {{otp}} variable.');"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPass}}\"\n}" }
          }
        },
        {
          "name": "Verify OTP (step 2) -> saves token",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('token', pm.response.json().token);",
              "  pm.test('JWT captured', () => pm.expect(pm.response.json().token).to.be.a('string'));",
              "}"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","verify-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"otp\": \"{{otp}}\"\n}" }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.rw\"\n}" }
          }
        },
        {
          "name": "Reset Password (reset OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.rw\",\n  \"otp\": \"{{otp}}\",\n  \"newPassword\": \"Brandnew123!\"\n}" }
          }
        }
      ]
    },
    {
      "name": "2. Customers",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/customers", "host": ["{{baseUrl}}"], "path": ["api","v1","customers"] },
            "body": { "mode": "raw", "raw": "{\n  \"fullNames\": \"John Habimana\",\n  \"nationalId\": \"1199080012345678\",\n  \"email\": \"john@example.rw\",\n  \"phoneNumber\": \"+250788654321\",\n  \"address\": \"KG 11 Ave, Kigali\",\n  \"status\": \"ACTIVE\"\n}" }
          }
        },
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/customers", "host": ["{{baseUrl}}"], "path": ["api","v1","customers"] }
          }
        },
        {
          "name": "Get customer by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/customers/1", "host": ["{{baseUrl}}"], "path": ["api","v1","customers","1"] }
          }
        }
      ]
    },
    {
      "name": "3. Meters",
      "item": [
        {
          "name": "Create meter",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/meters", "host": ["{{baseUrl}}"], "path": ["api","v1","meters"] },
            "body": { "mode": "raw", "raw": "{\n  \"meterNumber\": \"MTR-EL-0001\",\n  \"meterType\": \"ELECTRICITY\",\n  \"installationDate\": \"2025-01-15\",\n  \"customerId\": 1,\n  \"status\": \"ACTIVE\"\n}" }
          }
        },
        {
          "name": "List meters for customer",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/meters/customer/1", "host": ["{{baseUrl}}"], "path": ["api","v1","meters","customer","1"] }
          }
        }
      ]
    },
    {
      "name": "4. Config (Tariff/Tax/Penalty)",
      "item": [
        {
          "name": "Create tariff (TIERED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/config/tariffs", "host": ["{{baseUrl}}"], "path": ["api","v1","config","tariffs"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Electricity Residential 2026\",\n  \"meterType\": \"ELECTRICITY\",\n  \"tariffType\": \"TIERED\",\n  \"serviceCharge\": 1500.00,\n  \"effectiveStart\": \"2026-01-01\",\n  \"tiers\": [\n    { \"upToUnit\": 20, \"ratePerUnit\": 89 },\n    { \"upToUnit\": 50, \"ratePerUnit\": 212 },\n    { \"upToUnit\": null, \"ratePerUnit\": 249 }\n  ]\n}" }
          }
        },
        {
          "name": "Create tax (VAT 18%)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/config/taxes", "host": ["{{baseUrl}}"], "path": ["api","v1","config","taxes"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"VAT\",\n  \"percentage\": 18.00,\n  \"effectiveStart\": \"2026-01-01\"\n}" }
          }
        },
        {
          "name": "Create penalty (5%)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/config/penalties", "host": ["{{baseUrl}}"], "path": ["api","v1","config","penalties"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Late payment penalty\",\n  \"percentage\": 5.00,\n  \"effectiveStart\": \"2026-01-01\"\n}" }
          }
        }
      ]
    },
    {
      "name": "5. Readings",
      "item": [
        {
          "name": "Capture reading (OPERATOR/ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/readings", "host": ["{{baseUrl}}"], "path": ["api","v1","readings"] },
            "body": { "mode": "raw", "raw": "{\n  \"meterId\": 1,\n  \"currentReading\": 1320.00,\n  \"readingDate\": \"2026-05-31\",\n  \"month\": 5,\n  \"year\": 2026\n}" }
          }
        }
      ]
    },
    {
      "name": "6. Bills",
      "item": [
        {
          "name": "Generate bill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/bills/generate", "host": ["{{baseUrl}}"], "path": ["api","v1","bills","generate"] },
            "body": { "mode": "raw", "raw": "{\n  \"meterId\": 1,\n  \"month\": 5,\n  \"year\": 2026,\n  \"dueInDays\": 15\n}" }
          }
        },
        {
          "name": "Approve bill (id=1)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/bills/1/approve", "host": ["{{baseUrl}}"], "path": ["api","v1","bills","1","approve"] }
          }
        },
        {
          "name": "List bills",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/bills", "host": ["{{baseUrl}}"], "path": ["api","v1","bills"] }
          }
        }
      ]
    },
    {
      "name": "7. Payments",
      "item": [
        {
          "name": "Record payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/payments", "host": ["{{baseUrl}}"], "path": ["api","v1","payments"] },
            "body": { "mode": "raw", "raw": "{\n  \"billReference\": \"{{billRef}}\",\n  \"amountPaid\": 5000.00,\n  \"paymentMethod\": \"MOBILE_MONEY\",\n  \"paymentDate\": \"2026-06-05\"\n}" }
          }
        }
      ]
    },
    {
      "name": "8. Notifications",
      "item": [
        {
          "name": "Notifications for customer 1",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/notifications/customer/1", "host": ["{{baseUrl}}"], "path": ["api","v1","notifications","customer","1"] }
          }
        }
      ]
    },
    {
      "name": "9. Bad Cases (negative tests)",
      "item": [
        {
          "name": "401 - no token",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api","v1","users"] } }
        },
        {
          "name": "401 - wrong password",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"WRONG\"\n}" } }
        },
        {
          "name": "422 - wrong OTP",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/v1/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","verify-otp"] }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"otp\": \"000000\"\n}" } }
        },
        {
          "name": "409 - duplicate customer (nationalId)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/customers", "host": ["{{baseUrl}}"], "path": ["api","v1","customers"] }, "body": { "mode": "raw", "raw": "{\n  \"fullNames\": \"Dup\",\n  \"nationalId\": \"1199080012345678\",\n  \"email\": \"dup@example.rw\",\n  \"phoneNumber\": \"+250788000000\",\n  \"address\": \"X\",\n  \"status\": \"ACTIVE\"\n}" } }
        },
        {
          "name": "400 - validation errors",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/customers", "host": ["{{baseUrl}}"], "path": ["api","v1","customers"] }, "body": { "mode": "raw", "raw": "{\n  \"fullNames\": \"\",\n  \"nationalId\": \"1\",\n  \"email\": \"not-an-email\",\n  \"phoneNumber\": \"abc\",\n  \"address\": \"\"\n}" } }
        },
        {
          "name": "409 - duplicate meter number",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/meters", "host": ["{{baseUrl}}"], "path": ["api","v1","meters"] }, "body": { "mode": "raw", "raw": "{\n  \"meterNumber\": \"MTR-EL-0001\",\n  \"meterType\": \"WATER\",\n  \"installationDate\": \"2025-01-01\",\n  \"customerId\": 1,\n  \"status\": \"ACTIVE\"\n}" } }
        },
        {
          "name": "422 - reading current <= previous",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/readings", "host": ["{{baseUrl}}"], "path": ["api","v1","readings"] }, "body": { "mode": "raw", "raw": "{\n  \"meterId\": 1,\n  \"previousReading\": 1320,\n  \"currentReading\": 1000,\n  \"readingDate\": \"2026-06-30\",\n  \"month\": 6,\n  \"year\": 2026\n}" } }
        },
        {
          "name": "409 - duplicate reading (same month/year)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/readings", "host": ["{{baseUrl}}"], "path": ["api","v1","readings"] }, "body": { "mode": "raw", "raw": "{\n  \"meterId\": 1,\n  \"currentReading\": 1400,\n  \"readingDate\": \"2026-05-31\",\n  \"month\": 5,\n  \"year\": 2026\n}" } }
        },
        {
          "name": "422 - overpay bill",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/v1/payments", "host": ["{{baseUrl}}"], "path": ["api","v1","payments"] }, "body": { "mode": "raw", "raw": "{\n  \"billReference\": \"{{billRef}}\",\n  \"amountPaid\": 99999999,\n  \"paymentMethod\": \"CASH\"\n}" } }
        }
      ]
    }
  ]
}
